# ---------------------------------------------------------------------------
# PRODUCCIÓN (ISO 25010 – Seguridad). Antes de publicar el sistema:
#   APP_ENV=production
#   APP_DEBUG=false            <- nunca true: mostraría código y contraseñas
#   APP_URL=https://...        <- siempre HTTPS (el sistema fuerza https)
#   SESSION_SECURE_COOKIE=true
#   SESSION_ENCRYPT=true
#   SESSION_LIFETIME=30        <- cierra la sesión tras 30 min sin actividad
#   LOG_LEVEL=warning
# y usar un usuario de PostgreSQL propio (no "postgres") sin permiso de
# UPDATE/DELETE sobre auditoria_tablas y auditoria_movimientos.
#
# Servidor (hallazgos de OWASP ZAP que no se resuelven desde el código):
#   - PHP actualizado: la 8.2.12 de XAMPP tiene vulnerabilidades conocidas.
#   - php.ini: expose_php = Off (oculta la versión de PHP también en
#     archivos estáticos como robots.txt).
#   - El servidor web (Apache/Nginx) debe enviar X-Content-Type-Options: nosniff
#     también en los archivos estáticos de /public.
# ---------------------------------------------------------------------------
APP_NAME=SIGIP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=SigipDB
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo saliente (recuperación de contraseña). Con MAIL_MAILER=log los correos NO se envían:
# se guardan en storage/logs/laravel.log. Para enviarlos de verdad, por ejemplo con Gmail:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=cuenta-del-gimnasio@gmail.com
#   MAIL_PASSWORD="contraseña de aplicación de 16 letras"   (no la contraseña normal)
#   MAIL_FROM_ADDRESS=cuenta-del-gimnasio@gmail.com
# Luego: php artisan config:clear && php artisan correo:probar destino@correo.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Asistente con IA local (Ollama: https://ollama.com). Instalar Ollama y descargar el modelo:
#   ollama pull qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen2.5:7b
OLLAMA_TIEMPO=120
# false = solo procesador (si el controlador de la tarjeta de video no es compatible con Ollama)
OLLAMA_GPU=true
